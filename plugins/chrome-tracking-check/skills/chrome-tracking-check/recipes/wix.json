{
  "platform": "Wix",
  "detect_signatures": [
    "typeof window.wixBiSession !== 'undefined'",
    "!!document.querySelector('script[src*=\"parastorage.com\"]')"
  ],
  "templates_to_visit": [
    {"slug": "/", "label": "Homepage"},
    {"slug": "<shop>", "label": "Shop", "resolve_from": "homepage_link_matching:/shop|/product-page"},
    {"slug": "<contact>", "label": "Contact", "resolve_from": "homepage_link_matching:/contact"}
  ],
  "interactions": [
    {"on_template": "Product", "action": "guided", "prompt_user": "add to basket", "expected_event": "add_to_cart"}
  ],
  "suppressions": [],
  "notes": "Tags injected via Wix's own marketing-integrations panel; custom-code slots limited. Wix's own analytics beacons (frog.wix.com) are platform telemetry, not client tracking — don't report them as the client's tags."
